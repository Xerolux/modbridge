# ModBridge Environment Configuration
# Copy this file to .env and adjust values as needed.
#
# These are the only variables ModBridge reads. Everything else is configured
# in config.json (see config.example.json).

# Log level (DEBUG, INFO, WARN, ERROR). Overrides log_level from config.json.
LOG_LEVEL=INFO

# Timezone (read by the Go runtime)
TZ=UTC

# Web UI / API bind address
WEB_PORT=:8080

# Where ModBridge writes its files. The defaults are relative to the working
# directory; in a container point them at the mounted volumes, or the database
# and the logs are lost when the container is recreated.
# MODBRIDGE_DATA_DIR=/app/data
# MODBRIDGE_LOG_DIR=/app/logs
# MODBRIDGE_CONFIG=/app/config/config.json

# Secret used to derive CSRF tokens. Required when MODBRIDGE_ENV or GO_ENV is
# "production" — the server refuses to start without it. Otherwise a random
# secret is generated at startup.
# MODBRIDGE_CSRF_SECRET=

# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For header is
# trusted. Leave unset when ModBridge is reachable directly, otherwise clients
# can spoof their address in the audit log and the rate limiter.
# MODBRIDGE_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

# Multi-user authentication (set to 'true' to enable DB-backed users;
# also requires "multi_user": true in config.json). When enabled, an initial
# admin account is created on first start and its password is logged.
# MODBRIDGE_MULTI_USER=true

# Marks the deployment as production, which enables stricter startup checks.
# MODBRIDGE_ENV=production

# Enable the pprof endpoints. Do not set this in production.
# DEBUG=1

# Go runtime tuning
# GOMAXPROCS=4
# GOGC=100
